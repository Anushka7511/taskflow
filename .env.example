# Copy to .env and adjust. .env is git-ignored. Never commit real secrets.

# --- Application ---------------------------------------------------------
ENVIRONMENT=development            # "production" refuses placeholder secrets
LOG_LEVEL=INFO
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-generated-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (used by docker compose) -----------------------------------
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me        # avoid characters that need URL-escaping (@ : / ? #)
POSTGRES_DB=taskflow
DB_PORT=5433
API_PORT=8000

# --- Local development without Docker (read by the app itself) -----------
# DATABASE_URL=postgresql+psycopg://taskflow:change-me@localhost:5433/taskflow

# --- Tests (database name MUST end in _test; it is dropped and recreated) -
# TEST_DATABASE_URL=postgresql+psycopg://taskflow:change-me@localhost:5433/taskflow_test
